CEBINOVA_EMAIL_ALT=
CEBINOVA_PHONE="+91 96246 8831"
CEBINOVA_WHATSAPP=91962468831
CEBINOVA_ADDRESS="301, Satyam64, opp. Gujarat High Court, Sarkhej - Gandhinagar Hwy, Sola, Ahmedabad, Gujarat 380060"
